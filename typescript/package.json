{
  "name": "@pogly/spacetimedb-idc",
  "version": "0.1.2",
  "description": "Inter-database communication for SpacetimeDB, as a submodule: transactional outbox, push delivery, idempotent inbox and safe handoffs. Wire-compatible with idc.rs / Idc.cs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./handoff": {
      "types": "./src/handoff.ts",
      "default": "./dist/handoff.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "spacetimedb",
    "submodule",
    "inter-database-communication",
    "outbox",
    "messaging",
    "handoff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gazz-Stripbolt/spacetimedb-idc.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/Gazz-Stripbolt/spacetimedb-idc/tree/main/typescript#readme",
  "bugs": {
    "url": "https://github.com/Gazz-Stripbolt/spacetimedb-idc/issues"
  },
  "submodule": {
    "category": "integrations"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  },
  "peerDependencies": {
    "spacetimedb": "2.13.* || 2.14.*"
  },
  "devDependencies": {
    "spacetimedb": "2.14.*",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
